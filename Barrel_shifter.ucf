# ============================================================
# Spartan-6 XC6SLX9 (TQG144)
# Project: 8-bit Barrel Shifter (Left/Right)
# Inputs : data_in[7:0], shift[2:0], dir  → Switches
# Outputs: data_out[7:0] → LEDs (D2–D9)
# IOSTANDARD: LVCMOS33
# ============================================================

# -------------------- INPUTS (Switches) --------------------

# data_in[7:0]
NET "data_in[0]" LOC = P22 | IOSTANDARD = LVCMOS33;   # SW2
NET "data_in[1]" LOC = P21 | IOSTANDARD = LVCMOS33;   # SW4
NET "data_in[2]" LOC = P17 | IOSTANDARD = LVCMOS33;   # SW5
NET "data_in[3]" LOC = P16 | IOSTANDARD = LVCMOS33;   # SW6
NET "data_in[4]" LOC = P15 | IOSTANDARD = LVCMOS33;   # SW7
NET "data_in[5]" LOC = P14 | IOSTANDARD = LVCMOS33;   # SW8
NET "data_in[6]" LOC = P12 | IOSTANDARD = LVCMOS33;   # SW9
NET "data_in[7]" LOC = P11 | IOSTANDARD = LVCMOS33;   # SW10

# shift[2:0]
NET "shift[0]" LOC = P10 | IOSTANDARD = LVCMOS33;     # SW11
NET "shift[1]" LOC = P9  | IOSTANDARD = LVCMOS33;     # SW12
NET "shift[2]" LOC = P8  | IOSTANDARD = LVCMOS33;     # SW13

# direction control
NET "dir"      LOC = P7  | IOSTANDARD = LVCMOS33;     # SW15


# -------------------- OUTPUTS (LEDs) --------------------

NET "data_out[0]" LOC = P33 | IOSTANDARD = LVCMOS33;   # D2
NET "data_out[1]" LOC = P32 | IOSTANDARD = LVCMOS33;   # D3
NET "data_out[2]" LOC = P30 | IOSTANDARD = LVCMOS33;   # D4
NET "data_out[3]" LOC = P29 | IOSTANDARD = LVCMOS33;   # D5
NET "data_out[4]" LOC = P27 | IOSTANDARD = LVCMOS33;   # D6
NET "data_out[5]" LOC = P26 | IOSTANDARD = LVCMOS33;   # D7
NET "data_out[6]" LOC = P24 | IOSTANDARD = LVCMOS33;   # D8
NET "data_out[7]" LOC = P23 | IOSTANDARD = LVCMOS33;   # D9

# ============================================================